{
  "name": "cleanstreamweb",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/auth-refresh/apply.mjs .",
    "dev": "vite",
    "build": "node scripts/auth-refresh/verify-artifact.mjs . after && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:browser": "playwright test --config scripts/browser-tests/playwright.config.mjs",
    "test:auth-sdk": "vitest run --config scripts/auth-refresh/vitest.config.mjs",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:admin": "tsc -p tsconfig.admin.json",
    "typecheck:admin:edge": "tsc -p tsconfig.admin-edge.json",
    "test:admin:db": "node --test scripts/admin-db.test.mjs",
    "test:admin:edge": "node --experimental-strip-types --test scripts/admin-edge.test.mjs",
    "admin:owner": "node scripts/bootstrap-admin-owner.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.103.3",
    "dotenv": "^17.4.1",
    "lucide": "^1.6.0",
    "lucide-react": "^1.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "8.71.0",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
